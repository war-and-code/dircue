+package data
+
+import (
+	"bytes"
+	"fmt"
+	"math/rand"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+// Frozen helper before bounded selection. Unlike the optimized helper, this
+// oracle deliberately splits every LF field before selecting a prefix/suffix.
+func referenceGetLines(content []byte, n int) [][]byte {
+	var lines [][]byte
+	if len(content) != 0 {
+		lines = bytes.Split(content, []byte("\n"))
+	}
+	if n >= 0 {
+		if n < len(lines) {
+			lines = lines[:n]
+		}
+		return lines
+	}
+	limit := -n
+	if limit > len(lines) {
+		limit = len(lines)
+	}
+	result := make([][]byte, 0, limit)
+	for i := len(lines) - 1; i >= len(lines)-limit; i-- {
+		result = append(result, lines[i])
+	}
+	return result
+}
+
+func captureLines(fn func([]byte, int) [][]byte, content []byte, n int) (lines [][]byte, panicked any) {
+	defer func() { panicked = recover() }()
+	lines = fn(content, n)
+	return
+}
+
+func checkSelectedLines(t *testing.T, content []byte, n, spare int) {
+	t.Helper()
+	// Independent equal-capacity inputs expose aliasing/capacity changes without
+	// allowing mutation through one implementation to affect the other oracle.
+	actual := make([]byte, len(content), len(content)+spare)
+	original := make([]byte, len(content), len(content)+spare)
+	copy(actual, content)
+	copy(original, content)
+	got, gotPanic := captureLines(getLines, actual, n)
+	want, wantPanic := captureLines(referenceGetLines, original, n)
+	if reflect.TypeOf(gotPanic) != reflect.TypeOf(wantPanic) || fmt.Sprint(gotPanic) != fmt.Sprint(wantPanic) {
+		t.Fatalf("n=%d input=%q: panic got %v, want %v", n, content, gotPanic, wantPanic)
+	}
+	if gotPanic != nil {
+		return
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("n=%d input=%q: got %#v, want %#v", n, content, got, want)
+	}
+	for i := range got {
+		if cap(got[i]) != cap(want[i]) {
+			t.Fatalf("n=%d line=%d: inner capacity got %d, want %d", n, i, cap(got[i]), cap(want[i]))
+		}
+		if len(got[i]) > 0 {
+			got[i][0] ^= 0xff
+			want[i][0] ^= 0xff
+		}
+	}
+	if !bytes.Equal(actual, original) {
+		t.Fatalf("n=%d input=%q: line slices no longer alias matching original bytes", n, content)
+	}
+}
+
+func TestGetLinesExhaustiveBoundaries(t *testing.T) {
+	maxInt := int(^uint(0) >> 1)
+	requests := []int{-maxInt - 1, -maxInt, -41, -3, -2, -1, 0, 1, 2, 3, 40, 41, maxInt}
+	alphabet := []byte{'x', '\n', '\r', 0}
+	var visit func([]byte, int)
+	visit = func(content []byte, remaining int) {
+		for _, n := range requests {
+			checkSelectedLines(t, content, n, 0)
+			checkSelectedLines(t, content, n, 7)
+		}
+		if remaining == 0 {
+			return
+		}
+		for _, c := range alphabet {
+			visit(append(bytes.Clone(content), c), remaining-1)
+		}
+	}
+	visit(nil, 5)
+	for _, n := range requests {
+		got, gotPanic := captureLines(getLines, nil, n)
+		want, wantPanic := captureLines(referenceGetLines, nil, n)
+		if !reflect.DeepEqual(got, want) || reflect.TypeOf(gotPanic) != reflect.TypeOf(wantPanic) {
+			t.Fatalf("nil input n=%d differs", n)
+		}
+	}
+}
+
+func TestGetLinesRandomAndLargeInputs(t *testing.T) {
+	random := rand.New(rand.NewSource(97003))
+	maxInt := int(^uint(0) >> 1)
+	for trial := 0; trial < 5000; trial++ {
+		content := make([]byte, random.Intn(512))
+		for i := range content {
+			content[i] = byte(random.Intn(256))
+			if i%3 == 0 && random.Intn(2) == 0 {
+				content[i] = '\n'
+			}
+		}
+		for _, n := range []int{random.Intn(101) - 50, -maxInt - 1, -maxInt, 0, maxInt} {
+			checkSelectedLines(t, content, n, random.Intn(8))
+		}
+	}
+	for _, content := range [][]byte{
+		bytes.Repeat([]byte("x"), 128<<10),
+		bytes.Repeat([]byte("\n"), 128<<10),
+		bytes.Repeat([]byte("x\r\n"), 1<<15),
+		append(bytes.Repeat([]byte("x\n"), 1<<15), []byte("tail\r\x00")...),
+		[]byte("\xff\xc3\xa9\n\xef\xbb\xbf\n"),
+	} {
+		for _, n := range []int{-maxInt, -41, -2, -1, 0, 1, 3, 40, maxInt} {
+			checkSelectedLines(t, content, n, 9)
+		}
+	}
+}
+
+func TestGeneratedPrefixSelectionBoundaries(t *testing.T) {
+	tests := []struct {
+		name, ext, marker string
+		limit             int
+		predicate         func(string, string, []byte) bool
+	}{
+		{"haxe", ".cs", "// Generated by Haxe", 3, isGeneratedHaxe},
+		{"go", ".go", "// Code generated by example", 40, isGeneratedGo},
+		{"go-protobuf", ".proto", "// This file was autogenerated by go-to-protobuf", 20, isGeneratedProtobufFromGo},
+		{"protobuf", ".java", "// Generated by the protocol buffer compiler.  DO NOT EDIT!", 3, isGeneratedProtobuf},
+		{"thrift", ".java", "// Autogenerated by Thrift Compiler", 6, isGeneratedApacheThrift},
+	}
+	for _, test := range tests {
+		for _, newline := range []string{"\n", "\r\n"} {
+			for _, position := range []int{test.limit - 1, test.limit, test.limit + 1} {
+				content := strings.Repeat("plain"+newline, position-1) + test.marker + newline + "tail"
+				if got, want := test.predicate("file"+test.ext, test.ext, []byte(content)), position <= test.limit; got != want {
+					t.Errorf("%s marker line %d ending %q: got %t, want %t", test.name, position, newline, got, want)
+				}
+			}
+		}
+	}
+	// These predicates require multiple fields even when the marker is first.
+	for _, test := range []struct {
+		ext, marker string
+		predicate   func(string, string, []byte) bool
+	}{
+		{".go", "Code generated by example", isGeneratedGo},
+		{".proto", "This file was autogenerated by go-to-protobuf", isGeneratedProtobufFromGo},
+		{".java", "Generated by the protocol buffer compiler.  DO NOT EDIT!", isGeneratedProtobuf},
+	} {
+		if test.predicate("file"+test.ext, test.ext, []byte(test.marker)) || !test.predicate("file"+test.ext, test.ext, []byte(test.marker+"\n")) {
+			t.Errorf("minimum field count/trailing empty field changed for %s", test.ext)
+		}
+	}
+	if !isGeneratedJNIHeader("f.h", ".h", []byte("/* DO NOT EDIT THIS FILE - it is machine generated */\n#include <jni.h>")) ||
+		isGeneratedJNIHeader("f.h", ".h", []byte("/* DO NOT EDIT THIS FILE - it is machine generated */\r#include <jni.h>")) {
+		t.Error("JNI header requires LF-separated first two fields")
+	}
+	if !isGeneratedRacc("f.rb", ".rb", []byte("a\nb\n# This file is automatically generated by Racc")) ||
+		isGeneratedRacc("f.rb", ".rb", []byte("a\n# This file is automatically generated by Racc")) {
+		t.Error("Racc marker must be the third field")
+	}
+}
+
+func TestGeneratedFooterSelectionBoundaries(t *testing.T) {
+	for _, newline := range []string{"\n", "\r\n"} {
+		for trailing := 0; trailing <= 3; trailing++ {
+			content := "body" + newline + "//# sourceMappingURL=main.js.map" + strings.Repeat(newline, trailing)
+			if got, want := hasSourceMapReference("f.js", ".js", []byte(content)), trailing < 2; got != want {
+				t.Errorf("source map trailing=%d newline=%q: got %t, want %t", trailing, newline, got, want)
+			}
+			cassette := "body" + newline + "recorded_with: VCR" + strings.Repeat(newline, trailing)
+			if got, want := isVCRCassette("f.yml", ".yml", []byte(cassette)), trailing == 1; got != want {
+				t.Errorf("VCR trailing=%d newline=%q: got %t, want %t", trailing, newline, got, want)
+			}
+		}
+	}
+	coffee := "(function() {\nvar __bind = function() {};\n}).call(this);\n"
+	if !isCompiledCoffeeScript("f.js", ".js", []byte(coffee)) ||
+		isCompiledCoffeeScript("f.js", ".js", []byte(strings.TrimSuffix(coffee, "\n"))) ||
+		isCompiledCoffeeScript("f.js", ".js", []byte(coffee+"\n")) ||
+		isCompiledCoffeeScript("f.js", ".js", []byte(strings.ReplaceAll(coffee, "\n", "\r\n"))) {
+		t.Error("CoffeeScript exact reversed footer/raw CR requirements changed")
+	}
+	if hasSourceMapReference("f.js", ".js", []byte("body\r//# sourceMappingURL=x.map\r")) {
+		t.Error("bare CR became a line separator")
+	}
+}
