+	fs.files = append(fs.files, tracked)
+	return tracked, nil
+}
+
+type readerOwnershipFile struct {
+	billy.File
+	closes     int
+	closeError error
+}
+
+func (file *readerOwnershipFile) Close() error {
+	file.closes++
+	if err := file.File.Close(); err != nil {
+		return err
+	}
+	return file.closeError
+}
