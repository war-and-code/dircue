{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dircue offline automation guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "kind": {
      "const": "dircue-automation-guide"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "guidance",
          "examples"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          },
          "examples": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
