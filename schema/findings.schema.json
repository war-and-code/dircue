{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standalone ecosystem and framework findings",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "name",
      "root",
      "evidence",
      "detector"
    ],
    "properties": {
      "kind": {
        "enum": [
          "ecosystem",
          "framework",
          "layout"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "root": {
        "type": "string",
        "minLength": 1
      },
      "evidence": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "detector": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
