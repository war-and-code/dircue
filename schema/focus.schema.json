                },
                "path": {
                  "maxLength": 8192,
                  "type": "string"
                },
                "project_id": {
                  "maxLength": 8192,
                  "type": "string"
                }
              },
              "required": [
                "path",
                "bytes",
                "project_id",
                "ownership",
                "basis"
              ],
              "type": "object"
            },
            "maxItems": 200000,
            "type": "array"
          },
          "project": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "maxLength": 8192,
                "type": "string"
              },
              "kind": {
                "maxLength": 8192,
                "type": "string"
              },
              "parsed": {
                "type": "boolean"
              },
              "root": {
                "maxLength": 8192,
                "type": "string"
              }
            },
            "required": [
              "id",
              "root",
