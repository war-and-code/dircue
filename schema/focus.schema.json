    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "affected_by": {
          "maxLength": 8192,
          "type": "string"
        },
        "algorithm": {
          "const": "sha256"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "primary_project": {
          "maxLength": 8192,
          "type": "string"
        },
        "related_projects": {
          "items": {
            "maxLength": 8192,
            "type": "string"
          },
          "maxItems": 200000,
          "type": "array"
        },
        "role": {
          "enum": [
            "project",
            "affected-by"
          ]
        },
        "rule": {
          "enum": [
            "nearest-project-manifest-directory-v1",
            "direct-context-impact-v1"
          ]
        }
      },
      "required": [
        "id",
        "algorithm",
        "rule",
        "role",
        "related_projects"
      ],
      "type": "object"
    },
    "source": {
      "enum": [
        "git",
        "directory"
      ]
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "skipped"
      ]
    },
    "tree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    }
  },
  "required": [
    "provider",
    "provider_version",
    "status",
    "source",
    "scope",
    "limits",
    "coverage",
    "primary",
    "related",
    "context",
    "relations",
    "boundaries",
    "omissions"
  ],
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "git"
          }
        }
      },
      "then": {
        "required": [
          "tree"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "role": {
                "const": "project"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "primary_project"
        ],
        "properties": {
          "scope": {
            "required": [
              "primary_project"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "role": {
                "const": "affected-by"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "affected_projects"
        ],
        "not": {
          "required": [
            "primary_project"
          ]
        },
        "properties": {
          "scope": {
            "required": [
              "affected_by"
            ]
          },
          "primary": {
            "maxItems": 0
          },
          "related": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
