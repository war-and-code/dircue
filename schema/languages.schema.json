{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Linguist-compatible directory language statistics",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "size",
      "percentage"
    ],
    "allOf": [
      {
        "if": {
          "properties": {
            "percentage": {
              "const": "NaN"
            }
          },
          "required": [
            "percentage"
          ]
        },
        "then": {
          "properties": {
            "size": {
              "const": 0
            }
          }
        }
      }
    ],
    "properties": {
      "size": {
        "type": "integer",
        "minimum": 0
      },
      "percentage": {
        "type": "string",
        "pattern": "^(NaN|100\\.00|[0-9]\\.[0-9]{2}|[1-9][0-9]\\.[0-9]{2})$"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
