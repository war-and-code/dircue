{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded file format evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "provider": {
      "type": "string",
      "maxLength": 256
    },
    "provider_version": {
      "type": "string",
      "maxLength": 32
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "skipped"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "git",
            "directory"
          ]
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "consistency": {
          "type": "string",
          "maxLength": 256
        }
      },
      "required": [
        "mode",
        "consistency"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "git"
              }
            }
          },
          "then": {
            "required": [
              "tree"
            ]
          }
        }
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "string",
          "maxLength": 256
        },
        "selection": {
          "type": "string",
          "maxLength": 256
        },
        "archive_expansion": {
          "const": false
        }
      },
      "required": [
        "population",
        "selection",
        "archive_expansion"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "file_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "input_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        },
        "path_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "parser_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "parser_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "max_source_file_bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "file_bytes",
        "input_bytes",
        "files",
        "path_bytes",
        "output_bytes",
        "parser_depth",
        "parser_tokens",
        "max_source_file_bytes"
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selected_files": {
          "type": "integer",
          "minimum": 0
        },
        "selected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "inspected_files": {
          "type": "integer",
          "minimum": 0
        },
        "inspected_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "complete_reads": {
          "type": "integer",
          "minimum": 0
        },
        "prefix_reads": {
          "type": "integer",
          "minimum": 0
        },
        "omitted_files": {
          "type": "integer",
          "minimum": 0
        },
        "retained_observations": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "selected_files",
        "selected_bytes",
        "inspected_files",
        "inspected_bytes",
        "complete_reads",
        "prefix_reads",
        "omitted_files",
        "retained_observations"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "bytes_read": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65537
          },
          "read_scope": {
            "enum": [
              "complete",
              "prefix"
            ]
          },
          "evidence": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "format": {
                  "type": "string",
                  "maxLength": 64
                },
                "basis": {
                  "enum": [
                    "extension_hint",
                    "signature_match",
                    "parsed_prefix",
                    "complete_validation"
                  ]
                },
                "validation": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "required": [
                "format",
                "basis"
              ]
            }
          },
          "diagnostics": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        },
        "required": [
          "path",
          "bytes",
          "bytes_read",
          "read_scope",
          "evidence",
          "diagnostics"
        ]
      }
    },
    "omissions": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
    "provider",
    "provider_version",
    "status",
    "source",
    "scope",
    "limits",
    "coverage",
    "observations",
    "omissions"
  ]
}
